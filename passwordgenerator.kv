#:kivy 2.0

<GeneradorInterfaz>:
    orientation: 'vertical'
    padding: 18
    spacing: 12

    Label:
        text: "Generador de Contraseñas"
        font_size: '20sp'
        size_hint_y: None
        height: 35

    # Control de Longitud
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: 35
        spacing: 6

        Label:
            text: "Longitud:"
            size_hint_x: None
            width: 70
            font_size: '14sp'

        Slider:
            id: slider_longitud
            min: 6
            max: 32
            value: 16
            step: 1

        Label:
            text: str(int(slider_longitud.value))
            size_hint_x: None
            width: 30
            font_size: '14sp'

    # Opciones con Casillas de Verificación (2 columnas)
    GridLayout:
        cols: 2
        size_hint_y: None
        height: 110
        spacing: 6

        BoxLayout:
            orientation: 'horizontal'
            CheckBox:
                id: chk_mayus
                active: True
                size_hint_x: None
                width: 35
            Label:
                text: "Mayúsculas (A-Z)"
                font_size: '13sp'
                halign: 'left'
                valign: 'middle'
                text_size: self.size

        BoxLayout:
            orientation: 'horizontal'
            CheckBox:
                id: chk_minus
                active: True
                size_hint_x: None
                width: 35
            Label:
                text: "Minúsculas (a-z)"
                font_size: '13sp'
                halign: 'left'
                valign: 'middle'
                text_size: self.size

        BoxLayout:
            orientation: 'horizontal'
            CheckBox:
                id: chk_nums
                active: True
                size_hint_x: None
                width: 35
            Label:
                text: "Números (0-9)"
                font_size: '13sp'
                halign: 'left'
                valign: 'middle'
                text_size: self.size

        BoxLayout:
            orientation: 'horizontal'
            CheckBox:
                id: chk_simbolos
                active: True
                size_hint_x: None
                width: 35
            Label:
                text: "Símbolos (!@#$)"
                font_size: '13sp'
                halign: 'left'
                valign: 'middle'
                text_size: self.size

    # Campo de Texto para la Contraseña
    TextInput:
        text: root.contrasena_generada
        font_size: '15sp'
        multiline: False
        readonly: True
        halign: 'center'
        size_hint_y: None
        height: 45

    # Botones Compactos
    BoxLayout:
        orientation: 'vertical'
        size_hint_y: None
        height: 90
        spacing: 8

        Button:
            text: "Generar Contraseña"
            font_size: '15sp'
            size_hint_y: None
            height: 40
            background_color: 0.2, 0.6, 0.86, 1
            on_release: root.generar()

        Button:
            text: "Copiar"
            font_size: '15sp'
            size_hint_y: None
            height: 40
            background_color: 0.25, 0.75, 0.45, 1
            on_release: root.copiar()